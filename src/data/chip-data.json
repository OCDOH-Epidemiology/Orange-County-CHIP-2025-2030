      "id": "nutrition-security",
      "domain": "Economic Stability",
      "priority": "Nutrition Security",
      "goal": "Increase Food Security",
      "disparityAddressed": "Individuals with low socioeconomic status (SES)",
      "timeframe": {
        "start": "2026-07-01",
        "end": "2030-12-31"
      },
      "evidenceBasedStrategy": "Conduct standardized screening of unmet nutritional security needs and provide referrals to state, local, and federal benefit programs and community-based health-related social needs providers to address unmet needs.",
      "objective": {
        "number": "3.1",
        "description": "By December 31, 2030, increase food security among adults who make less than $25,000 by 5% from 78% to 81.9%.",
        "metric": "Food security among adults earning less than $25,000",
        "unit": "percent",
        "baseline": {
          "value": 78,
          "year": 2024
        },
        "target": {
          "value": 81.9,
          "year": 2030
        },
        "currentValue": null,
        "asOfDate": null,
        "source": null,
        "refreshCycleYears": 3,
        "direction": "higher_is_better",
        "dataSource": "Orange County Community Health Survey, 2024",
        "reportingFrequency": "Every 3 years",
        "stateComparison": {
          "value": 51.1,
          "label": "NYSDOH Prevention Agenda (State-Level)"
        }
      },
      "evaluationMeasures": [
        "# of community-based organizations (CBOs) conducting screenings and facilitation of referrals to benefit programs"
      ],
      "outcome": "Increased number of food insecure residents connected to resources",
      "milestones": [
        {
          "id": "3.1-m1",
          "description": "Establish a baseline of CBOs currently screening for food security with the OC Food Security and Healthy Eating Workgroup.",
          "targetDate": "2026-12-31",
          "baseline": "None",
          "dataSource": "CHIP evaluation database",
          "frequency": "Once",
          "status": "complete",
          "lastUpdated": "2026-08-15"
        },
        {
          "id": "3.1-m2",
          "description": "Increase the number of CBOs that conduct standardized food security screening and referrals by 5 facilities.",
          "targetDate": "2027-12-31",
          "baseline": "To be determined December 31, 2026",
          "dataSource": "CHIP evaluation database",
          "frequency": "Quarterly",
          "status": "in_progress",
          "lastUpdated": "2026-08-22"
        }
