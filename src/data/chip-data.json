      "id": "anxiety-stress",
      "domain": "Social & Community Context",
      "priority": "Anxiety and Stress",
      "goal": "Decrease anxiety and stress",
      "disparityAddressed": "Individuals with low socioeconomic status (SES)",
      "timeframe": {
        "start": "2026-09-01",
        "end": "2030-12-31"
      },
      "evidenceBasedStrategy": "Promote and increase awareness of evidence-based mindfulness resources to reduce the negative impact of stress and trauma.",
      "objective": {
        "number": "5.1",
        "description": "By December 31, 2030, decrease the percentage of adults in households with an annual income of less than $25,000 who experience moderate or severe mental distress by 5% from 47% to 44%.",
        "metric": "Adults earning less than $25,000 with moderate or severe mental distress",
        "unit": "percent",
        "baseline": {
          "value": 47,
          "year": 2024
        },
        "target": {
          "value": 44,
          "year": 2030
        },
        "currentValue": null,
        "asOfDate": null,
        "source": null,
        "refreshCycleYears": 1,
        "direction": "lower_is_better",
        "dataSource": "Orange County Community Health Survey, 2024",
        "reportingFrequency": "Yearly",
        "stateComparison": {
          "value": 18.9,
          "label": "NYSDOH Prevention Agenda goal by 2030"
        }
      },
      "evaluationMeasures": [
