    {
      "id": "crc-screening",
      "domain": "Health Care Access & Quality",
      "priority": "Preventive Services for Chronic Disease Prevention and Control",
      "goal": "Increase Colorectal Cancer Screening",
      "disparityAddressed": "Under-insured and uninsured individuals",
      "timeframe": {
        "start": "2027-01-01",
        "end": "2030-12-31"
      },
      "evidenceBasedStrategy": "Work with the NYS Cancer Screening Program (CSP) to improve access to cancer screening and diagnostic testing for individuals who are under-insured or without health insurance.",
      "objective": {
        "number": "33.0",
        "description": "By December 31, 2030, increase the percentage of adults ages 45–75 who receive a colorectal cancer screening based on the most recent guidance by 5% from 75.1% to 78.8%.",
        "metric": "Adults 45–75 up to date on colorectal cancer screening",
        "unit": "percent",
        "baseline": {
          "value": 75.1,
          "year": 2024
        },
        "target": {
          "value": 78.8,
          "year": 2030
        },
        "currentValue": null,
        "asOfDate": null,
        "source": null,
        "refreshCycleYears": 4,
        "direction": "higher_is_better",
        "dataSource": "NYS Behavioral Risk Factor Surveillance Survey (BRFSS), 2024",
        "reportingFrequency": "Every 4 years",
        "stateComparison": {
          "value": 83.5,
          "label": "NYSDOH Prevention Agenda goal by 2030"
        }
      },
      "evaluationMeasures": [
        "# of screening events",
        "# of individuals screened",
        "# of additional providers enrolled in CSP of the Hudson Valley"
      ],
      "outcome": "Increased number of adults able to receive colorectal cancer screenings",
      "milestones": [
        {
          "id": "33.0-m1",
          "description": "Provide at least 3 screening events with opportunities to receive colorectal screenings or test kits.",
          "targetDate": "2027-12-31",
          "baseline": "Zero",
          "dataSource": "CHIP Evaluation Database",
          "frequency": "Quarterly",
          "status": "in_progress",
          "lastUpdated": "2026-08-10"
        },
        {
          "id": "33.0-m2",
          "description": "Increase the average number of attendees at screening events from 200 to 250.",
          "targetDate": "2027-12-31",
          "baseline": "200 (3-year average 2024–YTD 2026)",
          "dataSource": "CHIP Evaluation Database",
          "frequency": "Quarterly",
          "status": "in_progress",
          "lastUpdated": "2026-08-10"
        },
        {
          "id": "33.0-m3",
          "description": "Increase the number of physicians enrolled in the CSP of the Hudson Valley program by 5.",
          "targetDate": "2028-06-30",
          "baseline": "To be determined",
          "dataSource": "Provided by CSP of the Hudson Valley (HITCH)",
          "frequency": "Quarterly",
          "status": "not_started",
